# Canonical production origin for metadata, sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://ajder.dev

# Create a PostHog project and copy its project token and ingestion host.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional: Search Console URL-prefix HTML-tag verification token.
# Domain properties use DNS verification instead and do not need this value.
GOOGLE_SITE_VERIFICATION=
